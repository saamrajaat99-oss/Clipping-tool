# AI Video Clipper & Publisher Studio - Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Storage Base Directory (defaults to ./storage)
STORAGE_DIR=./storage

# Hardware Acceleration
ENABLE_NVENC=True
GPU_DEVICE=0

# AI Transcription Settings
WHISPER_MODEL=base

# Optional Cloud LLM Keys (for advanced hook reasoning & title refinement)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Social Media OAuth (Can also be configured inside the UI)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
